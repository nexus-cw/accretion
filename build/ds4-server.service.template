# accretion ds4-server systemd unit (template).
# Configuration lives in /opt/accretion/etc/ds4-server.env — edit that, not this.
# Flags mirror the production-proven GB10 invocation.
[Unit]
Description=accretion ds4-server (LLM inference)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/accretion/etc/ds4-server.env
ExecStartPre=/usr/bin/mkdir -p ${DS4_KV_DIR}
# ExecStart runs the arch-swap wrapper, not a server binary directly: it
# reads DS4_ARCH from this unit's environment and execs the matching
# binary (ds4-server for deepseek4, ds4-inkling-server for inkling). The
# per-binary flag sets now live in build/accretion-serve, not here — see
# docs/CONSOLE.md "Architecture swap" for the full choreography.
ExecStart=/opt/accretion/bin/accretion-serve
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
